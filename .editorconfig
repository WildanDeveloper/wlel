# EditorConfig — https://editorconfig.org
# The formatter's canonical form is LF, 4-space indents and no trailing
# whitespace; these settings keep editors from fighting it.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
trim_trailing_whitespace = false
max_line_length = 80

[*.{yml,yaml}]
indent_size = 2

[*.{toml,lock}]
indent_size = 2

[*.sh]
indent_size = 4

[Makefile]
indent_style = tab
