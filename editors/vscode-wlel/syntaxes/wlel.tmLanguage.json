{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Wlel",
  "scopeName": "source.wlel",
  "fileTypes": ["wlel"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#paths" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#builtins" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.wlel",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.wlel",
          "match": "//.*$"
        }
      ]
    },
    "paths": {
      "patterns": [
        {
          "match": "\\b(std|sys)::([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "support.namespace.wlel" },
            "2": { "name": "support.function.wlel" }
          }
        },
        {
          "name": "support.namespace.wlel",
          "match": "\\b(std|sys)::"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.wlel",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.wlel",
              "match": "\\\\(?:n|t|r|\"|\\\\|0)"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.hexadecimal.wlel",
          "match": "\\b0[xX][0-9a-fA-F][0-9a-fA-F_]*(?:i8|i16|i32|i64|u8|u16|u32|u64|usize)?\\b"
        },
        {
          "name": "constant.numeric.integer.binary.wlel",
          "match": "\\b0[bB][01][01_]*(?:i8|i16|i32|i64|u8|u16|u32|u64|usize)?\\b"
        },
        {
          "name": "constant.numeric.integer.octal.wlel",
          "match": "\\b0[oO][0-7][0-7_]*(?:i8|i16|i32|i64|u8|u16|u32|u64|usize)?\\b"
        },
        {
          "name": "constant.numeric.float.wlel",
          "match": "\\b\\d[\\d_]*\\.\\d[\\d_]*(?:[eE][+-]?\\d+)?(?:f32|f64)?\\b"
        },
        {
          "name": "constant.numeric.float.wlel",
          "match": "\\b\\d[\\d_]*[eE][+-]?\\d+(?:f32|f64)?\\b"
        },
        {
          "name": "constant.numeric.integer.wlel",
          "match": "\\b\\d[\\d_]*(?:i8|i16|i32|i64|u8|u16|u32|u64|usize|byte|char)?\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "(\\bfn\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.wlel" },
            "2": { "name": "entity.name.function.wlel" }
          }
        },
        {
          "match": "(\\b(?:struct|enum|impl|test)\\s+)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.wlel" },
            "2": { "name": "entity.name.type.wlel" }
          }
        },
        {
          "name": "entity.name.type.wlel",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.wlel",
          "match": "\\b(?:if|else|while|for|in|break|continue|return|match)\\b"
        },
        {
          "name": "keyword.other.wlel",
          "match": "\\b(?:fn|extern|struct|enum|impl|use|test|as|defer|arena|let)\\b"
        },
        {
          "name": "constant.language.boolean.wlel",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "variable.language.self.wlel",
          "match": "\\bself\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.wlel",
          "match": "\\b(?:int|i8|i16|i32|i64|u8|u16|u32|u64|usize|f32|f64|float|bool|string|byte|char|void)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.wlel",
          "match": "\\b(?:new|wlel_sizeof|wlel_arena|wlel_alloc|wlel_free|wlel_arena_new|wlel_arena_alloc|wlel_arena_free|arena_stats|panic|assert|assert_eq)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.wlel",
          "match": "->"
        },
        {
          "name": "keyword.operator.arrow.wlel",
          "match": "=>"
        },
        {
          "name": "keyword.operator.assignment.wlel",
          "match": ":="
        },
        {
          "name": "keyword.operator.range.wlel",
          "match": "\\.\\."
        },
        {
          "name": "keyword.operator.wlel",
          "match": "==|!=|<=|>=|&&|\\|\\||<<|>>|\\+=|-=|\\*=|/=|%="
        },
        {
          "name": "keyword.operator.wlel",
          "match": "[-+*/%&|^~!<>=]"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.wlel",
          "match": "[{}\\[\\]()]"
        },
        {
          "name": "punctuation.separator.wlel",
          "match": "[,;:]"
        },
        {
          "name": "punctuation.accessor.wlel",
          "match": "\\."
        },
        {
          "name": "keyword.operator.try.wlel",
          "match": "\\?"
        }
      ]
    }
  }
}
