// parser.wlel — the Wlel parser, written in Wlel.
//
// The token stream comes from `lexer.wlel` (imported as a module), and the
// tree is a **flat arena of nodes**: `Node` is `{ kind, text, a, b, c, d,
// next, num, line, col }`, children are indices into one growable array, and
// the token text is a slice of the source. There is no `Box` per node and no
// per-node allocation: a file parses into one Vec[Node], which is the shape
// the checker and codegen will consume next.
//
// Usage:
//   parser <file>          parse and print a one-line summary
//   parser <file> dump     print the canonical AST, one node per line
use std;
use "lexer.wlel" as lx;

// ---- node kinds -----------------------------------------------------------
const N_PROGRAM: int = 1;
const N_USE: int = 2;
const N_MODULE: int = 3;
const N_CONST: int = 4;
const N_STRUCT: int = 5;
const N_FIELD: int = 6;
const N_ENUM: int = 7;
const N_VARIANT: int = 8;
const N_IMPL: int = 9;
const N_FN: int = 10;
const N_PARAM: int = 11;
const N_TEST: int = 12;
const N_TYPEPARAMS: int = 13;
const N_TYPES: int = 14;
const N_IMPORT_ITEM: int = 15;
const N_IMPORT_NAMES: int = 16;
const N_BLOCK: int = 20;
const N_LET: int = 21;
const N_SHORT: int = 22;
const N_ASSIGN: int = 23;
const N_RETURN: int = 24;
const N_IF: int = 25;
const N_WHILE: int = 26;
const N_FOR: int = 27;
const N_FORIN: int = 28;
const N_BREAK: int = 29;
const N_CONTINUE: int = 30;
const N_DEFER: int = 31;
const N_ARENA: int = 32;
const N_EXPR_STMT: int = 33;
const N_STMT_BLOCK: int = 34;
const N_MATCH_STMT: int = 35;
const N_IDENT: int = 40;
const N_INT: int = 41;
const N_UINT: int = 42;
const N_FLOAT: int = 43;
const N_STR: int = 44;
const N_BOOL: int = 45;
const N_UNARY: int = 46;
const N_BINARY: int = 47;
const N_CALL: int = 48;
const N_CALL_EXPR: int = 49;
const N_METHOD: int = 50;
const N_FIELD_ACCESS: int = 51;
const N_INDEX: int = 52;
const N_CAST: int = 53;
const N_STRUCT_LIT: int = 54;
const N_INIT: int = 55;
const N_ARRAY: int = 56;
const N_MATCH: int = 57;
const N_ARM: int = 58;
const N_TRY: int = 59;
const N_NEW: int = 60;
const N_SIZEOF: int = 61;
const N_CURRENT_ARENA: int = 62;
const N_BLOCK_EXPR: int = 63;
const N_WILDCARD: int = 70;
const N_VARIANT_PAT: int = 71;
const N_BINDS: int = 72;
const N_ERR: int = 99;

// binary operator codes (the Rust AST's BinOp order)
const OP_OR: int = 0;
const OP_AND: int = 1;
const OP_BITOR: int = 2;
const OP_BITXOR: int = 3;
const OP_BITAND: int = 4;
const OP_SHL: int = 5;
const OP_SHR: int = 6;
const OP_EQ: int = 7;
const OP_NE: int = 8;
const OP_LT: int = 9;
const OP_GT: int = 10;
const OP_LE: int = 11;
const OP_GE: int = 12;
const OP_ADD: int = 13;
const OP_SUB: int = 14;
const OP_MUL: int = 15;
const OP_DIV: int = 16;
const OP_MOD: int = 17;
const U_NEG: int = 0;
const U_NOT: int = 1;
const U_BITNOT: int = 2;

struct Node {
    kind: int,
    text: string,
    slice_start: int,
    slice_len: int,
    a: int,
    b: int,
    c: int,
    d: int,
    next: int,
    num: int,
    line: int,
    col: int,
    ty: int
} /// a source slice when `slice_len >= 0`, otherwise a synthesized string /// the type the checker inferred, as an index into its interned table; /// -1 until the checker runs. Codegen reads this instead of re-deriving /// types from source text, so comparing two types is comparing two ints.

struct P {
    src: string,
    toks: Vec[lx::Tok],
    pos: int,
    nodes: *Vec[Node],
    failed: bool,
    err_line: int,
    err_col: int,
    err_msg: string
}

fn new_node(p: *P, kind: int, line: int, col: int) -> int {
    n := Node { kind: kind, text: "", slice_start: 0, slice_len: -1, a: -1, b: -1, c: -1, d: -1, next: -1, num: 0, line: line, col: col, ty: -1 };
    p.nodes.push(n);
    return p.nodes.len() - 1;
}

fn get(p: *P, i: int) -> Node {
    return p.nodes.get(i);
}

fn set_a(p: *P, i: int, a: int) {
    n := p.nodes.get(i);
    n.a = a;
    p.nodes.set(i, n);
}

fn set_b(p: *P, i: int, b: int) {
    n := p.nodes.get(i);
    n.b = b;
    p.nodes.set(i, n);
}

fn set_c(p: *P, i: int, c: int) {
    n := p.nodes.get(i);
    n.c = c;
    p.nodes.set(i, n);
}

fn set_d(p: *P, i: int, d: int) {
    n := p.nodes.get(i);
    n.d = d;
    p.nodes.set(i, n);
}

fn set_next(p: *P, i: int, nxt: int) {
    n := p.nodes.get(i);
    n.next = nxt;
    p.nodes.set(i, n);
}

/// point the node's text at a token, with no allocation
fn set_slice(p: *P, i: int, t: lx::Tok) {
    n := p.nodes.get(i);
    n.slice_start = t.start;
    n.slice_len = t.end - t.start;
    p.nodes.set(i, n);
}

/// the node's text: a source slice or a synthesized string
fn text_of(p: *P, i: int) -> string {
    n := get(p, i);
    if n.slice_len < 0 {
        return n.text;
    }
    return std::str_sub(p.src, n.slice_start, n.slice_len);
}

fn set_text(p: *P, i: int, text: string) {
    n := p.nodes.get(i);
    n.text = text;
    n.slice_len = -1;
    p.nodes.set(i, n);
}

/// Record the inferred type on a node. The checker owns the type table, so it
/// passes the index in; the parser only stores it.
fn set_ty(nodes: *Vec[Node], i: int, ty: int) {
    n := nodes.get(i);
    n.ty = ty;
    nodes.set(i, n);
}

fn get_ty(nodes: *Vec[Node], i: int) -> int {
    if i < 0 || i >= nodes.len() {
        return -1;
    }
    return nodes.get(i).ty;
}

fn set_num(p: *P, i: int, num: int) {
    n := p.nodes.get(i);
    n.num = num;
    p.nodes.set(i, n);
}

fn fail(p: *P, msg: string) {
    if p.failed {
        return;
    }
    p.failed = true;
    t := tok(p);
    p.err_line = t.line;
    p.err_col = t.col;
    p.err_msg = msg;
}

fn tok(p: *P) -> lx::Tok {
    return p.toks.get(p.pos);
}

fn kind(p: *P) -> int {
    return tok(p).kind;
}

fn peek_at(p: *P, k: int) -> int {
    i := p.pos + k;
    if i >= p.toks.len() {
        return lx::T_EOF;
    }
    return p.toks.get(i).kind;
}

fn advance(p: *P) -> lx::Tok {
    t := tok(p);
    if t.kind != lx::T_EOF {
        p.pos += 1;
    }
    return t;
}

fn at(p: *P, k: int) -> bool {
    return kind(p) == k;
}

fn eat(p: *P, k: int) -> bool {
    if kind(p) == k {
        advance(p);
        return true;
    }
    return false;
}

fn expect(p: *P, k: int, what: string) -> lx::Tok {
    if kind(p) != k {
        fail(p, "expected " + what);
        return tok(p);
    }
    return advance(p);
}

fn tok_text(p: *P, t: lx::Tok) -> string {
    return std::str_sub(p.src, t.start, t.end - t.start);
}

/// The width suffix on a numeric literal (`10u8` -> "u8"), or "".
fn literal_suffix(raw: string) -> string {
    if ends_with(raw, "usize") {
        return "usize";
    }
    if ends_with(raw, "byte") {
        return "byte";
    }
    if ends_with(raw, "char") {
        return "char";
    }
    if ends_with(raw, "f32") {
        return "f32";
    }
    if ends_with(raw, "f64") {
        return "f64";
    }
    if ends_with(raw, "i16") {
        return "i16";
    }
    if ends_with(raw, "i32") {
        return "i32";
    }
    if ends_with(raw, "i64") {
        return "i64";
    }
    if ends_with(raw, "u16") {
        return "u16";
    }
    if ends_with(raw, "u32") {
        return "u32";
    }
    if ends_with(raw, "u64") {
        return "u64";
    }
    if ends_with(raw, "i8") {
        return "i8";
    }
    if ends_with(raw, "u8") {
        return "u8";
    }
    return "";
}

fn ends_with(s: string, tail: string) -> bool {
    n := std::strlen(s);
    m := std::strlen(tail);
    if m > n {
        return false;
    }
    return std::str_sub(s, n - m, m) == tail;
}

fn ident(p: *P) -> string {
    t := expect(p, lx::T_IDENT, "identifier");
    return tok_text(p, t);
}

fn slice_eq(s: string, start: int, end: int, want: string) -> bool {
    n := end - start;
    if n != std::strlen(want) {
        return false;
    }
    i := 0;
    while i < n {
        if s[start + i] != want[i] {
            return false;
        }
        i += 1;
    }
    return true;
}

fn ident_tok(p: *P) -> lx::Tok {
    return expect(p, lx::T_IDENT, "identifier");
}

// ---- types ----------------------------------------------------------------

/// a type is kept as its source spelling, built exactly like the Rust parser:
/// `*T`, `[T; N]`, `Name[A, B]`, `fn(A) -> R`
fn parse_type(p: *P) -> string {
    if at(p, lx::T_FN) {
        advance(p);
        expect(p, lx::T_LPAREN, "'('");
        params := "";
        first := true;
        if !at(p, lx::T_RPAREN) {
            while true {
                if !first {
                    params = params + ", ";
                }
                params = params + parse_type(p);
                first = false;
                if !eat(p, lx::T_COMMA) {
                    break;
                }
            }
        }
        expect(p, lx::T_RPAREN, "')'");
        ret := "void";
        if eat(p, lx::T_ARROW) {
            ret = parse_type(p);
        }
        return "fn(" + params + ") -> " + ret;
    }
    if at(p, lx::T_LBRACKET) {
        advance(p);
        inner := parse_type(p);
        expect(p, lx::T_SEMICOLON, "';'");
        t := expect(p, lx::T_INT, "array length");
        expect(p, lx::T_RBRACKET, "']'");
        return "[" + inner + "; " + tok_text(p, t) + "]";
    }
    stars := "";
    while eat(p, lx::T_STAR) {
        stars = stars + "*";
    }
    base := ident(p);
    while eat(p, lx::T_DOUBLECOLON) {
        base = base + "::" + ident(p);
    }
    if eat(p, lx::T_LBRACKET) {
        args := "";
        first := true;
        while true {
            if !first {
                args = args + ", ";
            }
            args = args + parse_type(p);
            first = false;
            if !eat(p, lx::T_COMMA) {
                break;
            }
        }
        expect(p, lx::T_RBRACKET, "']'");
        return stars + base + "[" + args + "]";
    }
    return stars + base;
}

fn type_params(p: *P, parent: int) -> int {
    if !at(p, lx::T_LBRACKET) {
        return -1;
    }
    n := new_node(p, N_TYPEPARAMS, tok(p).line, tok(p).col);
    advance(p);
    first := -1;
    last := -1;
    while true {
        t := expect(p, lx::T_IDENT, "type parameter");
        item := new_node(p, N_IDENT, t.line, t.col);
        set_text(p, item, tok_text(p, t));
        if first < 0 {
            first = item;
        } else {
            set_next(p, last, item);
        }
        last = item;
        if !eat(p, lx::T_COMMA) {
            break;
        }
        if at(p, lx::T_RBRACKET) {
            break;
        }
    }
    expect(p, lx::T_RBRACKET, "']'");
    set_a(p, n, first);
    set_d(p, parent, n);
    return n;
}

// ---- expressions ----------------------------------------------------------

/// binding power of a binary operator token (0 = not one)
fn lbp(k: int) -> int {
    if k == lx::T_OROR {
        return 2;
    }
    if k == lx::T_ANDAND {
        return 4;
    }
    if k == lx::T_BITOR {
        return 6;
    }
    if k == lx::T_BITXOR {
        return 8;
    }
    if k == lx::T_AMP {
        return 10;
    }
    if k == lx::T_EQ || k == lx::T_NEQ || k == lx::T_LT || k == lx::T_GT || k == lx::T_LTEQ || k == lx::T_GTEQ {
        return 12;
    }
    if k == lx::T_SHL || k == lx::T_SHR {
        return 14;
    }
    if k == lx::T_PLUS || k == lx::T_MINUS {
        return 16;
    }
    if k == lx::T_STAR || k == lx::T_SLASH || k == lx::T_PERCENT {
        return 18;
    }
    if k == lx::T_AS {
        return 20;
    }
    return 0;
}

fn binop(k: int) -> int {
    if k == lx::T_OROR {
        return lx::T_OROR;
    }
    return k;
}

/// the operator code the dump prints, one per Rust `BinOp`
fn op_code(k: int) -> int {
    if k == lx::T_OROR {
        return OP_OR;
    }
    if k == lx::T_ANDAND {
        return OP_AND;
    }
    if k == lx::T_BITOR {
        return OP_BITOR;
    }
    if k == lx::T_BITXOR {
        return OP_BITXOR;
    }
    if k == lx::T_AMP {
        return OP_BITAND;
    }
    if k == lx::T_SHL {
        return OP_SHL;
    }
    if k == lx::T_SHR {
        return OP_SHR;
    }
    if k == lx::T_EQ {
        return OP_EQ;
    }
    if k == lx::T_NEQ {
        return OP_NE;
    }
    if k == lx::T_LT {
        return OP_LT;
    }
    if k == lx::T_GT {
        return OP_GT;
    }
    if k == lx::T_LTEQ {
        return OP_LE;
    }
    if k == lx::T_GTEQ {
        return OP_GE;
    }
    if k == lx::T_PLUS {
        return OP_ADD;
    }
    if k == lx::T_MINUS {
        return OP_SUB;
    }
    if k == lx::T_STAR {
        return OP_MUL;
    }
    if k == lx::T_SLASH {
        return OP_DIV;
    }
    return OP_MOD;
}

fn expr(p: *P, min_bp: int) -> int {
    left := unary(p);
    while true {
        k := kind(p);
        bp := lbp(k);
        if bp == 0 || bp <= min_bp {
            break;
        }
        t := advance(p);
        if k == lx::T_AS {
            ty := parse_type(p);
            n := new_node(p, N_CAST, t.line, t.col);
            set_text(p, n, ty);
            set_a(p, n, left);
            left = n;
            continue;
        }
        right := expr(p, bp);
        n := new_node(p, N_BINARY, t.line, t.col);
        set_num(p, n, op_code(binop(k)));
        set_a(p, n, left);
        set_b(p, n, right);
        left = n;
    }
    return left;
}

fn unary(p: *P) -> int {
    k := kind(p);
    if k == lx::T_MINUS || k == lx::T_BANG || k == lx::T_BITNOT || k == lx::T_AMP || k == lx::T_STAR {
        t := advance(p);
        x := unary(p);
        n := new_node(p, N_UNARY, t.line, t.col);
        op := U_NEG;
        if k == lx::T_BANG {
            op = U_NOT;
        }
        if k == lx::T_BITNOT {
            op = U_BITNOT;
        }
        if k == lx::T_AMP {
            op = 3;
        }
        if k == lx::T_STAR {
            op = 4;
        }
        set_num(p, n, op);
        set_a(p, n, x);
        return n;
    }
    return postfix(p, primary(p));
}

fn postfix(p: *P, start: int) -> int {
    cur := start;
    while true {
        if at(p, lx::T_DOT) {
            t := advance(p);
            name := ident(p);
            if at(p, lx::T_LPAREN) {
                args := arg_list(p);
                n := new_node(p, N_METHOD, t.line, t.col);
                set_a(p, n, cur);
                set_text(p, n, name);
                set_b(p, n, args);
                cur = n;
            } else {
                n := new_node(p, N_FIELD_ACCESS, t.line, t.col);
                set_a(p, n, cur);
                set_text(p, n, name);
                cur = n;
            }
            continue;
        }
        if at(p, lx::T_LBRACKET) {
            advance(p);
            idx := expr(p, 0);
            expect(p, lx::T_RBRACKET, "']'");
            n := new_node(p, N_INDEX, 0, 0);
            set_a(p, n, cur);
            set_b(p, n, idx);
            cur = n;
            continue;
        }
        if at(p, lx::T_QUESTION) {
            t := advance(p);
            n := new_node(p, N_TRY, t.line, t.col);
            set_a(p, n, cur);
            cur = n;
            continue;
        }
        if at(p, lx::T_LPAREN) {
            args := arg_list(p);
            n := new_node(p, N_CALL_EXPR, 0, 0);
            set_a(p, n, cur);
            set_b(p, n, args);
            cur = n;
            continue;
        }
        break;
    }
    return cur;
}

fn arg_list(p: *P) -> int {
    expect(p, lx::T_LPAREN, "'('");
    first := -1;
    last := -1;
    if !at(p, lx::T_RPAREN) {
        while true {
            e := expr(p, 0);
            if first < 0 {
                first = e;
            } else {
                set_next(p, last, e);
            }
            last = e;
            if !eat(p, lx::T_COMMA) {
                break;
            }
        }
    }
    expect(p, lx::T_RPAREN, "')'");
    return first;
}

/// is the `[` at the cursor a type-argument list (followed by `(`)?
fn brackets_then_paren(p: *P) -> bool {
    depth := 0;
    i := p.pos;
    while i < p.toks.len() {
        k := p.toks.get(i).kind;
        if k == lx::T_LBRACKET {
            depth += 1;
        } else if k == lx::T_RBRACKET {
            depth -= 1;
            if depth == 0 {
                return i + 1 < p.toks.len() && p.toks.get(i + 1).kind == lx::T_LPAREN;
            }
        } else if k == lx::T_EOF {
            return false;
        }
        i += 1;
    }
    return false;
}

fn primary(p: *P) -> int {
    t := tok(p);
    k := t.kind;
    if k == lx::T_INT {
        advance(p);
        n := new_node(p, N_INT, t.line, t.col);
        set_text(p, n, tok_text(p, t));
        return n;
    }
    if k == lx::T_INT_SUF {
        advance(p);
        raw := tok_text(p, t);
        suffix := literal_suffix(raw);
        inner := new_node(p, N_INT, t.line, t.col);
        set_text(p, inner, raw);
        if suffix == "" {
            return inner;
        }
        n := new_node(p, N_CAST, t.line, t.col);
        set_text(p, n, suffix);
        set_a(p, n, inner);
        return n;
    }
    if k == lx::T_FLOAT || k == lx::T_FLOAT_SUF {
        advance(p);
        raw := tok_text(p, t);
        inner := new_node(p, N_FLOAT, t.line, t.col);
        set_text(p, inner, raw);
        if k == lx::T_FLOAT {
            return inner;
        }
        suffix := literal_suffix(raw);
        n := new_node(p, N_CAST, t.line, t.col);
        set_text(p, n, suffix);
        set_a(p, n, inner);
        return n;
    }
    if k == lx::T_STR {
        advance(p);
        n := new_node(p, N_STR, t.line, t.col);
        set_text(p, n, tok_text(p, t));
        return n;
    }
    if k == lx::T_TRUE || k == lx::T_FALSE {
        advance(p);
        n := new_node(p, N_BOOL, t.line, t.col);
        v := 0;
        if k == lx::T_TRUE {
            v = 1;
        }
        set_num(p, n, v);
        return n;
    }
    if k == lx::T_LPAREN {
        advance(p);
        e := expr(p, 0);
        expect(p, lx::T_RPAREN, "')'");
        return e;
    }
    if k == lx::T_LBRACKET {
        advance(p);
        n := new_node(p, N_ARRAY, t.line, t.col);
        first := -1;
        last := -1;
        if !at(p, lx::T_RBRACKET) {
            while true {
                e := expr(p, 0);
                if first < 0 {
                    first = e;
                } else {
                    set_next(p, last, e);
                }
                last = e;
                if !eat(p, lx::T_COMMA) {
                    break;
                }
            }
        }
        expect(p, lx::T_RBRACKET, "']'");
        set_a(p, n, first);
        return n;
    }
    if k == lx::T_MATCH {
        return match_expr(p);
    }
    if k == lx::T_LBRACE {
        b := block(p);
        n := new_node(p, N_BLOCK_EXPR, t.line, t.col);
        set_a(p, n, b);
        return n;
    }
    if k == lx::T_IDENT {
        advance(p);
        name := "";
        qualified := at(p, lx::T_DOUBLECOLON);
        if qualified {
            name = tok_text(p, t);
            while eat(p, lx::T_DOUBLECOLON) {
                name = name + "::" + ident(p);
            }
        }
        // wlel_sizeof(T) / new(T[, n]) / wlel_arena()
        is_sizeof := slice_eq(p.src, t.start, t.end, "wlel_sizeof");
        is_new := slice_eq(p.src, t.start, t.end, "new");
        is_arena := slice_eq(p.src, t.start, t.end, "wlel_arena");
        if is_sizeof && at(p, lx::T_LPAREN) {
            advance(p);
            ty := parse_type(p);
            expect(p, lx::T_RPAREN, "')'");
            n := new_node(p, N_SIZEOF, t.line, t.col);
            set_text(p, n, ty);
            return n;
        }
        if is_new && at(p, lx::T_LPAREN) {
            advance(p);
            ty := parse_type(p);
            cnt := -1;
            if eat(p, lx::T_COMMA) {
                cnt = expr(p, 0);
            }
            expect(p, lx::T_RPAREN, "')'");
            n := new_node(p, N_NEW, t.line, t.col);
            set_text(p, n, ty);
            set_a(p, n, cnt);
            return n;
        }
        if is_arena && at(p, lx::T_LPAREN) && peek_at(p, 1) == lx::T_RPAREN {
            advance(p);
            advance(p);
            return new_node(p, N_CURRENT_ARENA, t.line, t.col);
        }
        // generic call: name[T, ...](args)
        targs := -1;
        if at(p, lx::T_LBRACKET) && brackets_then_paren(p) {
            targs = new_node(p, N_TYPES, t.line, t.col);
            advance(p);
            first := -1;
            last := -1;
            while true {
                ty := parse_type(p);
                item := new_node(p, N_IDENT, t.line, t.col);
                set_text(p, item, ty);
                if first < 0 {
                    first = item;
                } else {
                    set_next(p, last, item);
                }
                last = item;
                if !eat(p, lx::T_COMMA) {
                    break;
                }
            }
            expect(p, lx::T_RBRACKET, "']'");
            set_a(p, targs, first);
        }
        if at(p, lx::T_LPAREN) {
            args := arg_list(p);
            n := new_node(p, N_CALL, t.line, t.col);
            if qualified {
                set_text(p, n, name);
            } else {
                set_slice(p, n, t);
            }
            set_a(p, n, targs);
            set_b(p, n, args);
            return n;
        }
        // struct literal: Name { field: value, ... }
        if at(p, lx::T_LBRACE) && peek_at(p, 1) == lx::T_IDENT && peek_at(p, 2) == lx::T_COLON {
            advance(p);
            n := new_node(p, N_STRUCT_LIT, t.line, t.col);
            if qualified {
                set_text(p, n, name);
            } else {
                set_slice(p, n, t);
            }
            first := -1;
            last := -1;
            while !at(p, lx::T_RBRACE) && !p.failed {
                ft := expect(p, lx::T_IDENT, "field name");
                expect(p, lx::T_COLON, "':'");
                v := expr(p, 0);
                f := new_node(p, N_INIT, ft.line, ft.col);
                set_slice(p, f, ft);
                set_a(p, f, v);
                if first < 0 {
                    first = f;
                } else {
                    set_next(p, last, f);
                }
                last = f;
                if !eat(p, lx::T_COMMA) {
                    break;
                }
            }
            expect(p, lx::T_RBRACE, "'}'");
            set_a(p, n, first);
            return n;
        }
        n := new_node(p, N_IDENT, t.line, t.col);
        if qualified {
            set_text(p, n, name);
        } else {
            set_slice(p, n, t);
        }
        return n;
    }
    fail(p, "expected an expression");
    return new_node(p, N_ERR, t.line, t.col);
}

fn pattern(p: *P) -> int {
    t := tok(p);
    if t.kind == lx::T_IDENT {
        advance(p);
        name := tok_text(p, t);
        if name == "_" {
            return new_node(p, N_WILDCARD, t.line, t.col);
        }
        while eat(p, lx::T_DOUBLECOLON) {
            name = name + "::" + ident(p);
        }
        if eat(p, lx::T_LPAREN) {
            binds := new_node(p, N_BINDS, t.line, t.col);
            first := -1;
            last := -1;
            if !at(p, lx::T_RPAREN) {
                while true {
                    bt := expect(p, lx::T_IDENT, "binding name");
                    b := new_node(p, N_IDENT, bt.line, bt.col);
                    set_slice(p, b, bt);
                    if first < 0 {
                        first = b;
                    } else {
                        set_next(p, last, b);
                    }
                    last = b;
                    if !eat(p, lx::T_COMMA) {
                        break;
                    }
                }
            }
            expect(p, lx::T_RPAREN, "')'");
            set_a(p, binds, first);
            n := new_node(p, N_VARIANT_PAT, t.line, t.col);
            set_text(p, n, name);
            set_a(p, n, first);
            return n;
        }
        n := new_node(p, N_IDENT, t.line, t.col);
        set_text(p, n, name);
        return n;
    }
    fail(p, "expected a pattern");
    return new_node(p, N_ERR, t.line, t.col);
}

fn match_expr(p: *P) -> int {
    t := expect(p, lx::T_MATCH, "'match'");
    scrut := expr(p, 0);
    expect(p, lx::T_LBRACE, "'{'");
    n := new_node(p, N_MATCH, t.line, t.col);
    set_a(p, n, scrut);
    first := -1;
    last := -1;
    while !at(p, lx::T_RBRACE) && !p.failed {
        pat := pattern(p);
        expect(p, lx::T_FATARROW, "'=>'");
        body := -1;
        if at(p, lx::T_LBRACE) {
            body = block(p);
        } else {
            body = expr(p, 0);
        }
        arm := new_node(p, N_ARM, t.line, t.col);
        set_a(p, arm, pat);
        set_b(p, arm, body);
        if first < 0 {
            first = arm;
        } else {
            set_next(p, last, arm);
        }
        last = arm;
        eat(p, lx::T_COMMA);
    }
    expect(p, lx::T_RBRACE, "'}'");
    set_b(p, n, first);
    return n;
}

// ---- statements -----------------------------------------------------------
fn block(p: *P) -> int {
    t := expect(p, lx::T_LBRACE, "'{'");
    n := new_node(p, N_BLOCK, t.line, t.col);
    first := -1;
    last := -1;
    while !at(p, lx::T_RBRACE) && !at(p, lx::T_EOF) && !p.failed {
        s := stmt(p);
        if first < 0 {
            first = s;
        } else {
            set_next(p, last, s);
        }
        last = s;
    }
    expect(p, lx::T_RBRACE, "'}'");
    set_a(p, n, first);
    return n;
}

fn stmt(p: *P) -> int {
    t := tok(p);
    k := t.kind;
    if k == lx::T_LET {
        advance(p);
        name := ident(p);
        ty := "";
        has_ty := false;
        if eat(p, lx::T_COLON) {
            ty = parse_type(p);
            has_ty = true;
        }
        if !at(p, lx::T_DEFINE) && !at(p, lx::T_ASSIGN) {
            fail(p, "expected ':=' or '=' after the declaration");
        } else {
            advance(p);
        }
        v := expr(p, 0);
        expect(p, lx::T_SEMICOLON, "';'");
        n := new_node(p, N_LET, t.line, t.col);
        set_text(p, n, name);
        if has_ty {
            tn := new_node(p, N_IDENT, t.line, t.col);
            set_text(p, tn, ty);
            set_a(p, n, tn);
        }
        set_b(p, n, v);
        return n;
    }
    if k == lx::T_RETURN {
        advance(p);
        e := -1;
        if !at(p, lx::T_SEMICOLON) {
            e = expr(p, 0);
        }
        expect(p, lx::T_SEMICOLON, "';'");
        n := new_node(p, N_RETURN, t.line, t.col);
        set_a(p, n, e);
        return n;
    }
    if k == lx::T_IF {
        return if_stmt(p);
    }
    if k == lx::T_WHILE {
        advance(p);
        c := expr(p, 0);
        b := block(p);
        n := new_node(p, N_WHILE, t.line, t.col);
        set_a(p, n, c);
        set_b(p, n, b);
        return n;
    }
    if k == lx::T_FOR {
        advance(p);
        var := ident(p);
        expect(p, lx::T_IN, "'in'");
        first := expr(p, 0);
        if eat(p, lx::T_DOTDOT) {
            last := expr(p, 0);
            b := block(p);
            n := new_node(p, N_FOR, t.line, t.col);
            set_text(p, n, var);
            set_a(p, n, first);
            set_b(p, n, last);
            set_c(p, n, b);
            return n;
        }
        b := block(p);
        n := new_node(p, N_FORIN, t.line, t.col);
        set_text(p, n, var);
        set_a(p, n, first);
        set_b(p, n, b);
        return n;
    }
    if k == lx::T_BREAK {
        advance(p);
        expect(p, lx::T_SEMICOLON, "';'");
        return new_node(p, N_BREAK, t.line, t.col);
    }
    if k == lx::T_CONTINUE {
        advance(p);
        expect(p, lx::T_SEMICOLON, "';'");
        return new_node(p, N_CONTINUE, t.line, t.col);
    }
    if k == lx::T_DEFER {
        advance(p);
        n := new_node(p, N_DEFER, t.line, t.col);
        if at(p, lx::T_LBRACE) {
            set_a(p, n, block(p));
        } else {
            set_a(p, n, expr(p, 0));
            expect(p, lx::T_SEMICOLON, "';'");
        }
        return n;
    }
    if k == lx::T_ARENA {
        advance(p);
        size := -1;
        if eat(p, lx::T_LPAREN) {
            size = expr(p, 0);
            expect(p, lx::T_RPAREN, "')'");
        }
        b := block(p);
        n := new_node(p, N_ARENA, t.line, t.col);
        set_a(p, n, size);
        set_b(p, n, b);
        return n;
    }
    if k == lx::T_LBRACE {
        b := block(p);
        n := new_node(p, N_STMT_BLOCK, t.line, t.col);
        set_a(p, n, b);
        return n;
    }
    // statement-form match: `match x { ... }` without a trailing `;`
    if k == lx::T_MATCH {
        m := match_expr(p);
        eat(p, lx::T_SEMICOLON);
        n := new_node(p, N_MATCH_STMT, t.line, t.col);
        set_a(p, n, m);
        return n;
    }
    // `name := expr;`
    if k == lx::T_IDENT && peek_at(p, 1) == lx::T_DEFINE {
        advance(p);
        name := tok_text(p, t);
        advance(p);
        v := expr(p, 0);
        expect(p, lx::T_SEMICOLON, "';'");
        n := new_node(p, N_LET, t.line, t.col);
        set_text(p, n, name);
        set_b(p, n, v);
        return n;
    }
    // assignment or expression statement
    e := expr(p, 0);
    if at(p, lx::T_ASSIGN) || at(p, lx::T_PLUSEQ) || at(p, lx::T_MINUSEQ) || at(p, lx::T_STAREQ) || at(p, lx::T_SLASHEQ) || at(p, lx::T_PERCENTEQ) {
        op := 0;
        ok := kind(p);
        if ok == lx::T_PLUSEQ {
            op = 1;
        }
        if ok == lx::T_MINUSEQ {
            op = 2;
        }
        if ok == lx::T_STAREQ {
            op = 3;
        }
        if ok == lx::T_SLASHEQ {
            op = 4;
        }
        if ok == lx::T_PERCENTEQ {
            op = 5;
        }
        advance(p);
        v := expr(p, 0);
        expect(p, lx::T_SEMICOLON, "';'");
        n := new_node(p, N_ASSIGN, t.line, t.col);
        set_num(p, n, op);
        set_a(p, n, e);
        set_b(p, n, v);
        return n;
    }
    expect(p, lx::T_SEMICOLON, "';'");
    n := new_node(p, N_EXPR_STMT, t.line, t.col);
    set_a(p, n, e);
    return n;
}

fn if_stmt(p: *P) -> int {
    t := expect(p, lx::T_IF, "'if'");
    cond := expr(p, 0);
    then_b := block(p);
    n := new_node(p, N_IF, t.line, t.col);
    set_a(p, n, cond);
    set_b(p, n, then_b);
    if eat(p, lx::T_ELSE) {
        if at(p, lx::T_IF) {
            set_c(p, n, if_stmt(p));
        } else {
            set_c(p, n, block(p));
        }
    }
    return n;
}

// ---- items ----------------------------------------------------------------
fn parse_use(p: *P) -> int {
    t := expect(p, lx::T_USE, "'use'");
    n := new_node(p, N_USE, t.line, t.col);
    path := "std";
    if at(p, lx::T_STR) {
        st := advance(p);
        raw := tok_text(p, st);
        path = std::str_sub(raw, 1, std::strlen(raw) - 2);
    } else if at(p, lx::T_IDENT) {
        it := advance(p);
        path = tok_text(p, it);
    } else {
        fail(p, "expected a path or a module name");
    }
    set_text(p, n, path);
    if eat(p, lx::T_AS) {
        alias := new_node(p, N_IDENT, t.line, t.col);
        set_text(p, alias, ident(p));
        set_a(p, n, alias);
    }
    if at(p, lx::T_LBRACE) {
        advance(p);
        names := new_node(p, N_IMPORT_NAMES, t.line, t.col);
        first := -1;
        last := -1;
        if eat(p, lx::T_STAR) {
            set_num(p, names, 1);
        } else {
            while !at(p, lx::T_RBRACE) && !p.failed {
                it := expect(p, lx::T_IDENT, "imported name");
                item := new_node(p, N_IMPORT_ITEM, it.line, it.col);
                set_slice(p, item, it);
                if eat(p, lx::T_AS) {
                    alias := new_node(p, N_IDENT, it.line, it.col);
                    set_text(p, alias, ident(p));
                    set_a(p, item, alias);
                }
                if first < 0 {
                    first = item;
                } else {
                    set_next(p, last, item);
                }
                last = item;
                if !eat(p, lx::T_COMMA) {
                    break;
                }
            }
        }
        expect(p, lx::T_RBRACE, "'}'");
        set_a(p, names, first);
        set_b(p, n, names);
    }
    expect(p, lx::T_SEMICOLON, "';'");
    return n;
}

fn parse_fn(p: *P) -> int {
    t := expect(p, lx::T_FN, "'fn'");
    n := new_node(p, N_FN, t.line, t.col);
    set_slice(p, n, ident_tok(p));
    type_params(p, n);
    expect(p, lx::T_LPAREN, "'('");
    first := -1;
    last := -1;
    if !at(p, lx::T_RPAREN) {
        while true {
            pt := expect(p, lx::T_IDENT, "parameter name");
            param := new_node(p, N_PARAM, pt.line, pt.col);
            set_slice(p, param, pt);
            if eat(p, lx::T_COLON) {
                ty := parse_type(p);
                tn := new_node(p, N_IDENT, pt.line, pt.col);
                set_text(p, tn, ty);
                set_a(p, param, tn);
            }
            if first < 0 {
                first = param;
            } else {
                set_next(p, last, param);
            }
            last = param;
            if !eat(p, lx::T_COMMA) {
                break;
            }
        }
    }
    expect(p, lx::T_RPAREN, "')'");
    set_a(p, n, first);
    if eat(p, lx::T_ARROW) {
        ty := parse_type(p);
        tn := new_node(p, N_IDENT, t.line, t.col);
        set_text(p, tn, ty);
        set_b(p, n, tn);
    }
    set_c(p, n, block(p));
    return n;
}

fn parse_item(p: *P) -> int {
    k := kind(p);
    if k == lx::T_MODULE {
        t := advance(p);
        n := new_node(p, N_MODULE, t.line, t.col);
        set_slice(p, n, ident_tok(p));
        expect(p, lx::T_SEMICOLON, "';'");
        return n;
    }
    if k == lx::T_USE {
        return parse_use(p);
    }
    if k == lx::T_CONST {
        t := advance(p);
        name := ident(p);
        expect(p, lx::T_COLON, "':'");
        ty := parse_type(p);
        expect(p, lx::T_ASSIGN, "'='");
        v := expr(p, 0);
        expect(p, lx::T_SEMICOLON, "';'");
        n := new_node(p, N_CONST, t.line, t.col);
        set_text(p, n, name);
        tn := new_node(p, N_IDENT, t.line, t.col);
        set_text(p, tn, ty);
        set_a(p, n, tn);
        set_b(p, n, v);
        return n;
    }
    if k == lx::T_STRUCT || k == lx::T_ENUM {
        t := advance(p);
        name := ident(p);
        if k == lx::T_STRUCT {
            n := new_node(p, N_STRUCT, t.line, t.col);
            set_text(p, n, name);
            type_params(p, n);
            expect(p, lx::T_LBRACE, "'{'");
            first := -1;
            last := -1;
            while !at(p, lx::T_RBRACE) && !p.failed {
                ft := expect(p, lx::T_IDENT, "field name");
                expect(p, lx::T_COLON, "':'");
                ty := parse_type(p);
                f := new_node(p, N_FIELD, ft.line, ft.col);
                set_slice(p, f, ft);
                tn := new_node(p, N_IDENT, ft.line, ft.col);
                set_text(p, tn, ty);
                set_a(p, f, tn);
                if first < 0 {
                    first = f;
                } else {
                    set_next(p, last, f);
                }
                last = f;
                if !eat(p, lx::T_COMMA) {
                    break;
                }
            }
            expect(p, lx::T_RBRACE, "'}'");
            set_a(p, n, first);
            return n;
        }
        n := new_node(p, N_ENUM, t.line, t.col);
        set_text(p, n, name);
        type_params(p, n);
        expect(p, lx::T_LBRACE, "'{'");
        first := -1;
        last := -1;
        while !at(p, lx::T_RBRACE) && !p.failed {
            vt := expect(p, lx::T_IDENT, "variant name");
            v := new_node(p, N_VARIANT, vt.line, vt.col);
            set_slice(p, v, vt);
            if eat(p, lx::T_LPAREN) {
                tys := new_node(p, N_TYPES, vt.line, vt.col);
                tfirst := -1;
                tlast := -1;
                if !at(p, lx::T_RPAREN) {
                    while true {
                        ty := parse_type(p);
                        tn := new_node(p, N_IDENT, vt.line, vt.col);
                        set_text(p, tn, ty);
                        if tfirst < 0 {
                            tfirst = tn;
                        } else {
                            set_next(p, tlast, tn);
                        }
                        tlast = tn;
                        if !eat(p, lx::T_COMMA) {
                            break;
                        }
                    }
                }
                expect(p, lx::T_RPAREN, "')'");
                set_a(p, tys, tfirst);
                set_a(p, v, tys);
            }
            if first < 0 {
                first = v;
            } else {
                set_next(p, last, v);
            }
            last = v;
            if !eat(p, lx::T_COMMA) {
                break;
            }
        }
        expect(p, lx::T_RBRACE, "'}'");
        set_a(p, n, first);
        return n;
    }
    if k == lx::T_IMPL {
        t := advance(p);
        n := new_node(p, N_IMPL, t.line, t.col);
        ty := ident(p);
        while eat(p, lx::T_DOUBLECOLON) {
            ty = ty + "::" + ident(p);
        }
        set_text(p, n, ty);
        type_params(p, n);
        expect(p, lx::T_LBRACE, "'{'");
        first := -1;
        last := -1;
        while !at(p, lx::T_RBRACE) && !p.failed {
            m := parse_fn(p);
            if first < 0 {
                first = m;
            } else {
                set_next(p, last, m);
            }
            last = m;
        }
        expect(p, lx::T_RBRACE, "'}'");
        set_a(p, n, first);
        return n;
    }
    if k == lx::T_TEST {
        t := advance(p);
        st := expect(p, lx::T_STR, "test name");
        n := new_node(p, N_TEST, t.line, t.col);
        raw := tok_text(p, st);
        set_text(p, n, std::str_sub(raw, 1, std::strlen(raw) - 2));
        set_a(p, n, block(p));
        return n;
    }
    if k == lx::T_EXTERN {
        advance(p);
        t2 := expect(p, lx::T_FN, "'fn'");
        n := new_node(p, N_FN, t2.line, t2.col);
        set_num(p, n, 1);
        set_slice(p, n, ident_tok(p));
        // the extern branch never sets a body; the dump reads n.c for normal
        // functions only, but a stale -1 must not reach `get`
        type_params(p, n);
        expect(p, lx::T_LPAREN, "'('");
        first := -1;
        last := -1;
        if !at(p, lx::T_RPAREN) {
            while true {
                pt := expect(p, lx::T_IDENT, "parameter name");
                param := new_node(p, N_PARAM, pt.line, pt.col);
                set_slice(p, param, pt);
                if eat(p, lx::T_COLON) {
                    ty := parse_type(p);
                    tn := new_node(p, N_IDENT, pt.line, pt.col);
                    set_text(p, tn, ty);
                    set_a(p, param, tn);
                }
                if first < 0 {
                    first = param;
                } else {
                    set_next(p, last, param);
                }
                last = param;
                if !eat(p, lx::T_COMMA) {
                    break;
                }
            }
        }
        expect(p, lx::T_RPAREN, "')'");
        set_a(p, n, first);
        if eat(p, lx::T_ARROW) {
            ty := parse_type(p);
            tn := new_node(p, N_IDENT, t2.line, t2.col);
            set_text(p, tn, ty);
            set_b(p, n, tn);
        }
        expect(p, lx::T_SEMICOLON, "';'");
        // the reference AST gives an extern declaration an empty body
        set_c(p, n, new_node(p, N_BLOCK, t2.line, t2.col));
        return n;
    }
    return parse_fn(p);
}

/// parse a whole file into `nodes`; returns the program node index
fn parse_program(p: *P) -> int {
    prog := new_node(p, N_PROGRAM, 1, 1);
    first := -1;
    last := -1;
    while !at(p, lx::T_EOF) && !p.failed {
        item := parse_item(p);
        if first < 0 {
            first = item;
        } else {
            set_next(p, last, item);
        }
        last = item;
    }
    set_a(p, prog, first);
    return prog;
}

// ---- dump -----------------------------------------------------------------
fn pad(b: *StrBuf, depth: int) {
    i := 0;
    while i < depth {
        std::str_buf_push(b, "  ");
        i += 1;
    }
}

fn put(b: *StrBuf, text: string) {
    std::str_buf_push(b, text);
}

fn nl(b: *StrBuf) {
    std::str_buf_push_char(b, 10);
}

fn dump_list(p: *P, b: *StrBuf, first: int, depth: int, tag: string) {
    i := first;
    while i >= 0 {
        dump_node(p, b, i, depth, tag);
        i = get(p, i).next;
    }
}

fn dump_type_of(p: *P, b: *StrBuf, i: int) {
    if i < 0 {
        put(b, "-");
        return;
    }
    put(b, text_of(p, i));
}

fn dump_node(p: *P, b: *StrBuf, i: int, depth: int, tag: string) {
    n := get(p, i);
    pad(b, depth);
    if tag != "" {
        put(b, tag);
        put(b, ":");
    }
    k := n.kind;
    if k == N_PROGRAM {
        put(b, "program");
        nl(b);
        dump_list(p, b, n.a, depth + 1, "");
        return;
    }
    if k == N_MODULE {
        put(b, "module " + text_of(p, i));
        nl(b);
        return;
    }
    if k == N_USE {
        put(b, "use " + text_of(p, i));
        if n.a >= 0 {
            put(b, " as " + text_of(p, n.a));
        }
        if n.b >= 0 {
            names := get(p, n.b);
            if names.num == 1 {
                put(b, " { * }");
            } else {
                put(b, " {");
                j := names.a;
                while j >= 0 {
                    item := get(p, j);
                    put(b, " " + text_of(p, j));
                    if item.a >= 0 {
                        put(b, " as " + text_of(p, item.a));
                    }
                    j = item.next;
                }
                put(b, " }");
            }
        }
        nl(b);
        return;
    }
    if k == N_CONST {
        put(b, "const " + text_of(p, i) + ":");
        dump_type_of(p, b, n.a);
        nl(b);
        dump_node(p, b, n.b, depth + 1, "value");
        return;
    }
    if k == N_STRUCT {
        put(b, "struct " + text_of(p, i) + tparams_text(p, n.d));
        nl(b);
        dump_list(p, b, n.a, depth + 1, "");
        return;
    }
    if k == N_FIELD {
        put(b, "field " + text_of(p, i) + ":");
        dump_type_of(p, b, n.a);
        nl(b);
        return;
    }
    if k == N_ENUM {
        put(b, "enum " + text_of(p, i) + tparams_text(p, n.d));
        nl(b);
        dump_list(p, b, n.a, depth + 1, "");
        return;
    }
    if k == N_VARIANT {
        put(b, "variant " + text_of(p, i));
        if n.a >= 0 {
            put(b, "(");
            j := get(p, n.a).a;
            first := true;
            while j >= 0 {
                if !first {
                    put(b, ", ");
                }
                put(b, text_of(p, j));
                first = false;
                j = get(p, j).next;
            }
            put(b, ")");
        }
        nl(b);
        return;
    }
    if k == N_IMPL {
        put(b, "impl " + text_of(p, i) + tparams_text(p, n.d));
        nl(b);
        dump_list(p, b, n.a, depth + 1, "");
        return;
    }
    if k == N_FN {
        put(b, "fn " + text_of(p, i) + tparams_text(p, n.d));
        if n.num == 1 {
            put(b, " extern");
        }
        nl(b);
        dump_list(p, b, n.a, depth + 1, "param");
        pad(b, depth + 1);
        put(b, "ret:");
        dump_type_of(p, b, n.b);
        nl(b);
        if n.c >= 0 {
            dump_node(p, b, n.c, depth + 1, "body");
        }
        return;
    }
    if k == N_PARAM {
        put(b, "param " + text_of(p, i));
        if n.a >= 0 {
            put(b, ":");
            dump_type_of(p, b, n.a);
        }
        nl(b);
        return;
    }
    if k == N_TEST {
        put(b, "test " + text_of(p, i));
        nl(b);
        dump_node(p, b, n.a, depth + 1, "body");
        return;
    }
    if k == N_BLOCK {
        put(b, "block");
        nl(b);
        dump_list(p, b, n.a, depth + 1, "");
        return;
    }
    if k == N_LET {
        put(b, "let " + text_of(p, i));
        if n.a >= 0 {
            put(b, ":");
            dump_type_of(p, b, n.a);
        }
        nl(b);
        dump_node(p, b, n.b, depth + 1, "value");
        return;
    }
    if k == N_SHORT {
        put(b, "short " + text_of(p, i));
        nl(b);
        dump_node(p, b, n.a, depth + 1, "value");
        return;
    }
    if k == N_ASSIGN {
        put(b, "assign " + std::int_to_str(n.num));
        nl(b);
        dump_node(p, b, n.a, depth + 1, "target");
        dump_node(p, b, n.b, depth + 1, "value");
        return;
    }
    if k == N_RETURN {
        put(b, "return");
        nl(b);
        if n.a >= 0 {
            dump_node(p, b, n.a, depth + 1, "value");
        }
        return;
    }
    if k == N_IF {
        put(b, "if");
        nl(b);
        dump_node(p, b, n.a, depth + 1, "cond");
        dump_node(p, b, n.b, depth + 1, "then");
        if n.c >= 0 {
            if get(p, n.c).kind == N_IF {
                pad(b, depth + 1);
                put(b, "else-if:");
                nl(b);
                dump_node(p, b, n.c, depth + 1, "");
            } else {
                dump_node(p, b, n.c, depth + 1, "else");
            }
        }
        return;
    }
    if k == N_WHILE {
        put(b, "while");
        nl(b);
        dump_node(p, b, n.a, depth + 1, "cond");
        dump_node(p, b, n.b, depth + 1, "body");
        return;
    }
    if k == N_FOR {
        put(b, "for " + text_of(p, i));
        nl(b);
        dump_node(p, b, n.a, depth + 1, "start");
        dump_node(p, b, n.b, depth + 1, "end");
        dump_node(p, b, n.c, depth + 1, "body");
        return;
    }
    if k == N_FORIN {
        put(b, "for-in " + text_of(p, i));
        nl(b);
        dump_node(p, b, n.a, depth + 1, "iter");
        dump_node(p, b, n.b, depth + 1, "body");
        return;
    }
    if k == N_BREAK {
        put(b, "break");
        nl(b);
        return;
    }
    if k == N_CONTINUE {
        put(b, "continue");
        nl(b);
        return;
    }
    if k == N_DEFER {
        put(b, "defer");
        nl(b);
        dump_node(p, b, n.a, depth + 1, "body");
        return;
    }
    if k == N_ARENA {
        put(b, "arena");
        nl(b);
        if n.a >= 0 {
            dump_node(p, b, n.a, depth + 1, "size");
        }
        dump_node(p, b, n.b, depth + 1, "body");
        return;
    }
    if k == N_EXPR_STMT {
        put(b, "expr");
        nl(b);
        dump_node(p, b, n.a, depth + 1, "");
        return;
    }
    if k == N_MATCH_STMT {
        put(b, "match-stmt");
        nl(b);
        m := get(p, n.a);
        dump_node(p, b, m.a, depth + 1, "scrutinee");
        dump_list(p, b, m.b, depth + 1, "");
        return;
    }
    if k == N_STMT_BLOCK {
        put(b, "stmt-block");
        nl(b);
        dump_node(p, b, n.a, depth + 1, "");
        return;
    }
    if k == N_IDENT {
        put(b, "ident " + text_of(p, i));
        nl(b);
        return;
    }
    if k == N_INT {
        put(b, "int " + text_of(p, i));
        nl(b);
        return;
    }
    if k == N_UINT {
        put(b, "uint " + text_of(p, i));
        nl(b);
        return;
    }
    if k == N_FLOAT {
        put(b, "float " + text_of(p, i));
        nl(b);
        return;
    }
    if k == N_STR {
        put(b, "str " + text_of(p, i));
        nl(b);
        return;
    }
    if k == N_BOOL {
        put(b, "bool " + std::int_to_str(n.num));
        nl(b);
        return;
    }
    if k == N_UNARY {
        put(b, "unary " + std::int_to_str(n.num));
        nl(b);
        dump_node(p, b, n.a, depth + 1, "");
        return;
    }
    if k == N_BINARY {
        put(b, "binary " + std::int_to_str(n.num));
        nl(b);
        dump_node(p, b, n.a, depth + 1, "l");
        dump_node(p, b, n.b, depth + 1, "r");
        return;
    }
    if k == N_CALL {
        put(b, "call " + text_of(p, i));
        if n.a >= 0 {
            put(b, "[");
            j := get(p, n.a).a;
            first := true;
            while j >= 0 {
                if !first {
                    put(b, ", ");
                }
                put(b, text_of(p, j));
                first = false;
                j = get(p, j).next;
            }
            put(b, "]");
        }
        nl(b);
        dump_list(p, b, n.b, depth + 1, "arg");
        return;
    }
    if k == N_CALL_EXPR {
        put(b, "call-expr");
        nl(b);
        dump_node(p, b, n.a, depth + 1, "callee");
        dump_list(p, b, n.b, depth + 1, "arg");
        return;
    }
    if k == N_METHOD {
        put(b, "method " + text_of(p, i));
        nl(b);
        dump_node(p, b, n.a, depth + 1, "recv");
        dump_list(p, b, n.b, depth + 1, "arg");
        return;
    }
    if k == N_FIELD_ACCESS {
        put(b, "field " + text_of(p, i));
        nl(b);
        dump_node(p, b, n.a, depth + 1, "recv");
        return;
    }
    if k == N_INDEX {
        put(b, "index");
        nl(b);
        dump_node(p, b, n.a, depth + 1, "value");
        dump_node(p, b, n.b, depth + 1, "index");
        return;
    }
    if k == N_CAST {
        put(b, "cast " + text_of(p, i));
        nl(b);
        dump_node(p, b, n.a, depth + 1, "");
        return;
    }
    if k == N_STRUCT_LIT {
        put(b, "struct-lit " + text_of(p, i));
        nl(b);
        dump_list(p, b, n.a, depth + 1, "");
        return;
    }
    if k == N_INIT {
        put(b, "init " + text_of(p, i));
        nl(b);
        dump_node(p, b, n.a, depth + 1, "value");
        return;
    }
    if k == N_ARRAY {
        put(b, "array");
        nl(b);
        dump_list(p, b, n.a, depth + 1, "elem");
        return;
    }
    if k == N_MATCH {
        put(b, "match");
        nl(b);
        dump_node(p, b, n.a, depth + 1, "scrutinee");
        dump_list(p, b, n.b, depth + 1, "");
        return;
    }
    if k == N_ARM {
        put(b, "arm");
        nl(b);
        dump_node(p, b, n.a, depth + 1, "pattern");
        dump_node(p, b, n.b, depth + 1, "body");
        return;
    }
    if k == N_TRY {
        put(b, "try");
        nl(b);
        dump_node(p, b, n.a, depth + 1, "");
        return;
    }
    if k == N_NEW {
        put(b, "new " + text_of(p, i));
        nl(b);
        if n.a >= 0 {
            dump_node(p, b, n.a, depth + 1, "count");
        }
        return;
    }
    if k == N_SIZEOF {
        put(b, "sizeof " + text_of(p, i));
        nl(b);
        return;
    }
    if k == N_CURRENT_ARENA {
        put(b, "current-arena");
        nl(b);
        return;
    }
    if k == N_BLOCK_EXPR {
        put(b, "block-expr");
        nl(b);
        dump_node(p, b, n.a, depth + 1, "");
        return;
    }
    if k == N_WILDCARD {
        put(b, "wildcard");
        nl(b);
        return;
    }
    if k == N_VARIANT_PAT {
        put(b, "variant-pat " + text_of(p, i));
        if n.a >= 0 {
            put(b, "(");
            j := n.a;
            first := true;
            while j >= 0 {
                if !first {
                    put(b, ",");
                }
                put(b, text_of(p, j));
                first = false;
                j = get(p, j).next;
            }
            put(b, ")");
        }
        nl(b);
        return;
    }
    put(b, "err");
    nl(b);
}

fn tparams_text(p: *P, t: int) -> string {
    if t < 0 {
        return "";
    }
    out := "[";
    j := get(p, t).a;
    first := true;
    while j >= 0 {
        if !first {
            out = out + ",";
        }
        out = out + text_of(p, j);
        first = false;
        j = get(p, j).next;
    }
    return out + "]";
}

fn main() -> int {
    if sys::argc() < 2 {
        sys::eprintln("usage: parser <file> [dump]");
        return 2;
    }
    path := sys::arg(1);
    src := "";
    if !sys::read_file(path, &src) {
        sys::eprintln("parser: cannot read " + path);
        return 1;
    }
    toks := vec_new[lx::Tok]();
    l := lx::Lexer { src: src, len: std::strlen(src), pos: 0, line: 1, col: 1 };
    while true {
        t := l.next();
        if t.kind == lx::T_ERR {
            sys::eprintln("parser: " + std::int_to_str(t.line) + ":" + std::int_to_str(t.col) + ": invalid token");
            return 1;
        }
        toks.push(t);
        if t.kind == lx::T_EOF {
            break;
        }
    }
    bench := sys::argc() >= 3 && sys::arg(2) == "bench";
    if bench {
        iters := 20;
        t0 := sys::mono_ms();
        total := 0;
        k := 0;
        while k < iters {
            ns := vec_new[Node]();
            pp := P { src: src, toks: toks, pos: 0, nodes: &ns, failed: false, err_line: 0, err_col: 0, err_msg: "" };
            parse_program(&pp);
            total = total + ns.len();
            k += 1;
        }
        elapsed := sys::mono_ms() - t0;
        mbps := 0;
        if elapsed > 0 {
            mbps = std::strlen(src) * iters / (elapsed * 1000);
        }
        std::println_str(std::int_to_str(iters) + " passes, " + std::int_to_str(total) + " nodes, " + std::int_to_str(elapsed) + " ms, " + std::int_to_str(mbps) + " MB/s");
        return 0;
    }
    nodes := vec_new[Node]();
    p := P { src: src, toks: toks, pos: 0, nodes: &nodes, failed: false, err_line: 0, err_col: 0, err_msg: "" };
    prog := parse_program(&p);
    if p.failed {
        sys::eprintln("parser: " + std::int_to_str(p.err_line) + ":" + std::int_to_str(p.err_col) + ": " + p.err_msg);
        return 1;
    }
    if sys::argc() >= 3 && sys::arg(2) == "dump" {
        b := std::str_buf_new();
        dump_node(&p, b, prog, 0, "");
        std::print_str(std::str_buf_finish(b));
        return 0;
    }
    std::println_int(nodes.len());
    return 0;
}
